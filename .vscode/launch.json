{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Murdoku solution creator",
            "type": "debugpy",
            "request": "launch",
            "module": "murdoku_checker.mains.main_generate_new_puzzle",
            "args": [
                "use_cases\\generate-puzzle\\inputs\\example.json",
                "--format",
                "html",
                "--solver-logs"
